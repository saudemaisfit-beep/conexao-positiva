# Copiar para .env.local e preencher. Nunca colocar valores reais neste ficheiro.

# URL canónico do site (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp em formato internacional, só dígitos (ex.: 244900000000).
# Vazio = o botão flutuante de WhatsApp não é mostrado.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Fases seguintes (CMS, base de dados, e-mail, anti-spam, analytics) acrescentam aqui as suas variáveis.

# Pré-visualização de design: "1" preenche as secções sem conteúdo real com exemplos
# marcados [Exemplo]. Nunca ativar em produção.
CONTENT_PREVIEW=
