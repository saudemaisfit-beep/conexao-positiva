# Copiar para .env.local e preencher. Nunca colocar valores reais neste ficheiro.

# URL canónico do site (sem barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp em formato internacional, só dígitos (ex.: 244900000000).
# Vazio = o botão flutuante de WhatsApp não é mostrado.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Fases seguintes (CMS, base de dados, e-mail, anti-spam, analytics) acrescentam aqui as suas variáveis.

# Pré-visualização de design: "1" preenche as secções sem conteúdo real com exemplos
# marcados [Exemplo]. Nunca ativar em produção.
CONTENT_PREVIEW=

# ---------- Formulários (Fase 14) ----------
# Sem base de dados configurada, em produção os envios devolvem "indisponível" (nenhum pedido
# se perde em silêncio). FORMS_DRY_RUN=1 simula o envio com sucesso: SÓ para testes.
FORMS_DRY_RUN=

# Supabase: URL do projeto e chave SECRETA (sb_secret_… ou service_role). Só no servidor:
# nunca usar o prefixo NEXT_PUBLIC_ nem colocar a chave no código.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# E-mails (Resend). O domínio do remetente tem de estar verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM="Conexão Positiva <nao-responder@conexaopositiva.ao>"
# Quem recebe os avisos de novos pedidos (separar por vírgulas).
EMAIL_TEAM_TO=

# Cloudflare Turnstile (anti-robô). A chave do site é pública; a secreta fica no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (limite de pedidos partilhado entre instâncias). Sem estes valores, o limite
# funciona por instância (em memória).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sanity (CMS). O ID do projeto e o dataset são públicos (identificam o projeto).
# Sem ID, o site funciona sem CMS e /studio mostra instruções de configuração.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Segredo partilhado com o webhook do Sanity (gerar com: openssl rand -hex 32). Só no servidor.
SANITY_REVALIDATE_SECRET=
