# =============================================================================
# Conexão Positiva — variáveis de ambiente
# =============================================================================
#
# Produção (Hostinger, plano Business): hPanel → Websites → a aplicação Node.js →
#   Variáveis de ambiente. Introduzir cada linha (nome e valor). Fazer novo build depois de
#   alterar qualquer variável NEXT_PUBLIC_* (estas são fixadas no momento do build).
# As chaves com "# " à frente estão desativadas (a Hostinger pede valor para todas as ativas).
#   Para ativar uma, retirar o "# " e preencher o valor — ou acrescentá-la no hPanel quando houver valor.
# Desenvolvimento: copiar este ficheiro para .env.local, preencher e usar
#   NEXT_PUBLIC_SITE_URL=https://conexaopositiva.ao.
#
# NUNCA colocar valores reais neste ficheiro nem em nenhum ficheiro do repositório.
#
# Legenda:
#   [OBRIGATÓRIA] o site publicado precisa dela    [OPCIONAL] funciona sem ela
#   [PÚBLICA] aparece no browser (não é segredo)   [SECRETA] só no servidor, nunca partilhar
# =============================================================================


# ---------- 1. Site --------------------------------------------------------------

# [OBRIGATÓRIA] [PÚBLICA] Endereço do site, sem barra final. Usado no sitemap, nos endereços
# canónicos, nas imagens de partilha e nos e-mails. Tem de estar definida ANTES do build.
# Produção: o domínio final (ex.: https://conexaopositiva.ao — por confirmar, decisão D2).
NEXT_PUBLIC_SITE_URL=https://conexaopositiva.ao

# [OPCIONAL] [PÚBLICA] WhatsApp em formato internacional, só dígitos (ex.: 244923000000).
# Vazio = sem botão de WhatsApp. (Também pode ser definido no CMS, em Definições do site.)
# NEXT_PUBLIC_WHATSAPP_NUMBER=


# ---------- 2. CMS — Sanity (Fase 13) --------------------------------------------
# Sem ID de projeto, o site funciona sem conteúdos do CMS e /studio mostra instruções.

# [OBRIGATÓRIA] [PÚBLICA] ID do projeto Sanity (sanity.io/manage → projeto → Project ID).
# NEXT_PUBLIC_SANITY_PROJECT_ID=

# [OBRIGATÓRIA] [PÚBLICA] Dataset do Sanity.
NEXT_PUBLIC_SANITY_DATASET=production

# [OBRIGATÓRIA] [SECRETA] Segredo do webhook de publicação (o mesmo valor no Sanity → API →
# Webhooks). Gerar com: openssl rand -hex 32
# SANITY_REVALIDATE_SECRET=


# ---------- 3. Base de dados — Supabase (Fase 14) ---------------------------------
# Sem estes valores, em produção os formulários mostram "Não foi possível enviar" e os
# contactos alternativos (nenhum pedido se perde em silêncio).
# ATENÇÃO: ativar só depois da validação jurídica da decisão D5 (dados alojados na Europa).

# [OBRIGATÓRIA] [PÚBLICA] URL do projeto (Supabase → Project Settings → API → Project URL).
# SUPABASE_URL=

# [OBRIGATÓRIA] [SECRETA] Chave secreta (sb_secret_…) ou service_role. Dá acesso total aos
# pedidos e inscrições: nunca com prefixo NEXT_PUBLIC_, nunca no código.
# SUPABASE_SECRET_KEY=


# ---------- 4. E-mail — caixa de correio da Hostinger (Fase 14) --------------------
# Criar a caixa no hPanel → Emails (ex.: nao-responder@conexaopositiva.ao).

# [OBRIGATÓRIA] [PÚBLICA] Servidor de envio da Hostinger.
SMTP_HOST=smtp.hostinger.com

# [OBRIGATÓRIA] [PÚBLICA] 465 (SSL). Usar 587 só se a Hostinger o indicar.
SMTP_PORT=465

# [OBRIGATÓRIA] [PÚBLICA] Endereço completo da caixa que envia.
# SMTP_USER=

# [OBRIGATÓRIA] [SECRETA] Palavra-passe dessa caixa.
# SMTP_PASSWORD=

# [OPCIONAL] [PÚBLICA] Remetente mostrado. Tem de usar a caixa acima.
# Vazio = "Conexão Positiva" <SMTP_USER>.
# EMAIL_FROM=

# [OBRIGATÓRIA] [PÚBLICA] Quem recebe os avisos de novos pedidos (separar por vírgulas).
# EMAIL_TEAM_TO=


# ---------- 5. Anti-spam — Cloudflare Turnstile (Fase 14) -------------------------
# Sem as duas chaves, a verificação é ignorada (ficam o campo-isco, o tempo mínimo e o
# limite de pedidos). Recomendado em produção.

# [OPCIONAL] [PÚBLICA] Site key (Cloudflare → Turnstile → widget do domínio).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# [OPCIONAL] [SECRETA] Secret key do mesmo widget.
# TURNSTILE_SECRET_KEY=


# ---------- 6. Estatísticas — Google Analytics 4 (Fase 16) ------------------------

# [OPCIONAL] [PÚBLICA] ID de medição (G-XXXXXXXXXX). Só é carregado depois de a pessoa aceitar
# as estatísticas no aviso de cookies. Vazio = sem analytics.
# NEXT_PUBLIC_GA_ID=


# ---------- 7. Limite de pedidos partilhado — Upstash Redis (Fase 14) --------------
# Na Hostinger (um único processo) não é necessário: o limite em memória já é partilhado.
# Só faz falta se o site passar a correr em várias instâncias.

# [OPCIONAL] [PÚBLICA] REST URL da base Redis.
# UPSTASH_REDIS_REST_URL=

# [OPCIONAL] [SECRETA] REST token da base Redis.
# UPSTASH_REDIS_REST_TOKEN=


# ---------- 8. Só para desenvolvimento e testes ---------------------------------
# Deixar SEMPRE vazias em produção.

# "1" preenche as secções sem conteúdo com exemplos marcados [Exemplo] (revisão de design).
# CONTENT_PREVIEW=

# "1" simula o envio dos formulários com sucesso, sem gravar nada (testes automáticos).
# FORMS_DRY_RUN=
