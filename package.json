{
  "name": "conexao-positiva",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test:unit": "PLAYWRIGHT_UNIT_ONLY=1 NODE_OPTIONS=\"--import ./tests/unit/register.mjs\" playwright test --project=unit",
    "build:test": "CONTENT_PREVIEW=1 FORMS_DRY_RUN=1 next build --webpack",
    "test:e2e": "playwright test --project=e2e",
    "test:live": "playwright test --project=live",
    "test": "npm run test:unit && npm run build:test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@sanity/locale-pt-pt": "1.1.37",
    "@sanity/vision": "6.16.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.8",
    "next-intl": "4.14.6",
    "next-sanity": "13.3.4",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sanity": "6.16.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
